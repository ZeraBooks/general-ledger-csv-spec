{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZeraBooks/general-ledger-csv-spec/schema/trial-balance-row.schema.json",
  "title": "Trial balance row",
  "description": "One account's balance at a date. The balance sits in debit or credit, not both. Total debits equal total credits.",
  "type": "object",
  "required": ["account_number", "account_name", "account_type", "debit", "credit"],
  "additionalProperties": false,
  "properties": {
    "account_number": {"type": "string"},
    "account_name": {"type": "string"},
    "account_type": {"enum": ["asset", "liability", "equity", "revenue", "expense"]},
    "debit": {"type": "string", "pattern": "^$|^[0-9]+\\.[0-9]{2}$"},
    "credit": {"type": "string", "pattern": "^$|^[0-9]+\\.[0-9]{2}$"}
  }
}
